{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/validate_docs_update.py\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& 'D:\\miniconda3\\python.exe' (Join-Path (git rev-parse --show-toplevel) '.codex\\hooks\\validate_docs_update.py')\"",
            "timeout": 30,
            "statusMessage": "Checking documentation updates"
          }
        ]
      }
    ]
  }
}
